# DocMind Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (get free at: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: "auto" | "gemini" | "ollama"
#   auto   — try Ollama first, fall back to Gemini if not running
#   gemini — always use Gemini API
#   ollama — always use local Ollama
LLM_PROVIDER=auto
