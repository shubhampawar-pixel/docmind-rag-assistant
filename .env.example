# DocMind Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (get free at: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Cloud Fallback)
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider: "gemini" | "groq" | "auto" | "ollama"
#   gemini — primary cloud LLM
#   groq   — fallback cloud LLM
#   auto   — multi-tier fallback (Gemini -> Groq -> Ollama)
#   ollama — local Ollama inference
LLM_PROVIDER=auto

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=docmind
